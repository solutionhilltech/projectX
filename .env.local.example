# Copy to .env.local and fill in. Never commit the filled-in file.
# Most of these can also be set from the dashboard's Settings view, which
# stores them in MongoDB; the value here is the seed until one is saved there.

# --- Required ---------------------------------------------------------------
AUTH_SECRET=
MONGODB_URI=
# Used for search planning, and for the redesign prompt when GROQ_API_KEY is unset.
OPENROUTER_API_KEY=

# --- Scouting ---------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# --- Redesign ---------------------------------------------------------------
# Preferred prompt writer: faster and more reliable than OpenRouter's free tier.
# Groq serves no general Llama chat model — gpt-oss-120b is the default.
GROQ_API_KEY=
GROQ_MODEL=
# Optional: pin one OpenRouter model instead of the built-in free list.
OPENROUTER_MODEL=
# Optional: Jina Reader renders pages (JS included) to markdown for scraping.
# Without it the scraper falls back to a plain fetch of the raw HTML.
JINA_API_KEY=
# Both must be set, or the redesign route runs in mock mode.
STITCH_MCP_URL=https://stitch.googleapis.com/mcp
STITCH_API_KEY=

# --- WhatsApp delivery ------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_ID=

# --- Optional: authenticate Stitch as a Google user instead of by API key ----
# Complete the one-time flow at /api/stitch/auth after filling these in.
STITCH_OAUTH_CLIENT_ID=
STITCH_OAUTH_CLIENT_SECRET=
STITCH_OAUTH_SCOPES=
GOOGLE_CLOUD_PROJECT=
